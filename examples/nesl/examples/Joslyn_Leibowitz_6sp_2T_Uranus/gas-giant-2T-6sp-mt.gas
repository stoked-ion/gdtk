-- Taine
-- This is a custom gas model, combining features from a TwoTemperatureGas and a MultiTemperatureGas.
-- It avoids the issues associated with calculating T_ve once H2 has fully dissociated.
-- prep-gas is not setup for this so ahd to added a posteriori.

model = 'CompositeGas'
species = {'He', 'H2', 'H', 'H+', 'He+', 'e-', }

physical_model = 'multi-temperature-gas'
energy_modes = {"vibroelectronic"}
db = {}

db.modes = {
  vibroelectronic = {
    "H2:vib",
    "H2:electronic",
    "He:electronic",
    "H:electronic",
    "H+:electronic",
    "He+:electronic",
    "e-:electron",
  },
}

